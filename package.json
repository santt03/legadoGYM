{
  "name": "legadogym",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "npm run dev",
    "serve": "tsx server/index.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "db:setup": "tsx server/setup.ts",
    "db:check": "tsx server/check-db.ts",
    "db:seed-demo": "tsx server/seed-demo.ts",
    "admin:create": "tsx server/create-admin.ts",
    "staff:create": "tsx server/create-staff.ts",
    "backup:db": "tsx server/backup.ts",
    "check:api": "tsc -p server/tsconfig.json",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.45.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
